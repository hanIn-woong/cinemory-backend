# CineMory 운영 환경변수 템플릿 (deploy-spec 1-1 · 2-5)
# 서버에 /etc/cinemory/cinemory.env 로 복사해 값을 채운다 — 권한 600, 소유자 root.
#   sudo install -m 600 -o root -g root cinemory.env.example /etc/cinemory/cinemory.env
# ⚠️ 이 템플릿에는 값을 쓰지 않는다. 값이 든 파일은 리포에 절대 커밋하지 않는다.
# ⚠️ 누락된 키는 ProdStartupGuard가 키 이름을 모아 기동을 실패시킨다. 값이 틀린 것은 잡지 못한다(Phase 3-4·5에서 확인).
# 형식: KEY=value (따옴표·export 없이, systemd EnvironmentFile 문법)

DB_URL=jdbc:mysql://127.0.0.1:3306/cinemory?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
# 앱 전용 계정(2-4). root 금지.
DB_USERNAME=cinemory_app
DB_PASSWORD=

# 신규 발급: openssl rand -base64 64  (로컬 값 재사용 금지)
JWT_SECRET=

TMDB_ACCESS_TOKEN=
KOFIC_API_KEY=

# Gmail 앱 비밀번호. MAIL_FROM = MAIL_USERNAME
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 네이티브 앱 키 하나만(REST API 키 금지 — 최소 권한)
KAKAO_ALLOWED_AUDIENCES=

# 구글 웹 클라이언트 ID 하나만(Android 클라이언트 ID 아님 — 토큰 aud는 웹 클라이언트 ID)
GOOGLE_ALLOWED_AUDIENCES=
